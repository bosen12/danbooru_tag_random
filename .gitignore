__pycache__/
*.py[cod]
.hallmark/
scripts/harvest_report.json
scripts/.cache_danbooru_tags.json
scripts/.cache_*.json
docs/

# Telegram bot token 住在這裡，不要進 git
.secrets/

# 拿舊 commit 解壓出來做前後比對用的暫存基準，整包是 git 裡已有的東西，
# 別讓它有機會被 `git add -A` 掃進版控（一份就 40MB）。
.tmp_baseline_*

# 機器專屬設定（ComfyUI 路徑、checkpoint 資料夾…）。範本見 config.example.json
config.json

# 使用者匯入的 workflow profile、畫面存的 Comfy URL
data/

# 卡牌插畫是用你自己的底模烘焙出來的（scripts/bake_card_art.py），不進版控。
# 墨池、字鋪共用 web/cards/；zipu/art/extras.json 是 prompt 清單，要進版控。
web/cards/
zipu/art/*.webp
zipu/art/manifest.json
# 啟動檔的卡面偵測：選了「以後都不要問」
.no-card-bake
